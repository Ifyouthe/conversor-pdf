# =============================================
# CONFIGURACIÓN CONVERSOR PDF - SUMATE
# =============================================

# Puerto del servidor
PORT=3004

# Entorno (en producción SIEMPRE production: en development los errores 500
# devuelven el mensaje interno)
NODE_ENV=production

# Secreto compartido. Con valor, toda petición (salvo GET /health) debe traer
# la cabecera X-API-Key con este valor; si no, 401. Vacío = servicio abierto
# (solo para desarrollo local). Generar con: openssl rand -hex 32
CONVERSOR_API_KEY=

# API de iLovePDF (para conversión de documentos)
ILOVEPDF_PUBLIC_KEY=your_ilovepdf_public_key
ILOVEPDF_SECRET_KEY=your_ilovepdf_secret_key

# URL del servicio constructor de documentos y su secreto (X-API-Key)
CONSTRUCTOR_DOCUMENTOS_URL=http://localhost:3003
CONSTRUCTOR_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de conversión
MAX_FILE_SIZE_MB=10
DEFAULT_CONVERSION_METHOD=puppeteer # puppeteer | ilovepdf
ENABLE_FALLBACK=true

# Configuración Puppeteer
PUPPETEER_HEADLESS=new
PUPPETEER_TIMEOUT=60000

# Configuración de cache temporal
TEMP_DIR=/tmp/pdf-converter
CLEANUP_INTERVAL_MS=300000
